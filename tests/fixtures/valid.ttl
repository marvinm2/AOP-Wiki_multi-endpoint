@prefix aopo: <http://aopkb.org/aop_ontology#> .
@prefix dc:   <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Minimal well-formed AOP-Wiki-style snippet used by the rdf-validation CI gate
# to prove validate_rdf.py accepts syntactically valid Turtle.
<http://identifiers.org/aop/1> a aopo:AdverseOutcomePathway ;
    dc:title "Example adverse outcome pathway" ;
    dcterms:created "2026-01-01"^^<http://www.w3.org/2001/XMLSchema#date> .

<http://identifiers.org/aop.events/1> a aopo:KeyEvent ;
    dc:title "Example key event" .
